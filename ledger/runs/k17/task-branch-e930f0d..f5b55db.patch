+// AC-11: testFileBasename, called with 'x.js (already exists)', 'dir/x.js', 'x.js',
+// 'substrate/test/x.js (skipped: exists)' and '  x.js  ', returns 'x.js' for every input.
+//
+// Written from the spec ONLY. Extracts the fix-loop decisions block from
+// .claude/workflows/build-implement.js (via this TestSet's own extract-fixloop.js) and evaluates
+// testFileBasename directly, rather than importing a sibling helper file that is not part of this
+// TestSet directory.
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { readWorkflowText, extractBlock } from './extract-fixloop.js'
+
+function loadTestFileBasename() {
+  const { block } = extractBlock(readWorkflowText())
+  if (block == null) throw new Error('fix-loop decisions block not found between the sentinel lines')
+  // eslint-disable-next-line no-new-func
+  const factory = new Function(block + '\nreturn { testFileBasename }')
+  return factory().testFileBasename
+}
+
+test('AC-11: testFileBasename strips trailing parentheticals and directories to a bare basename', () => {
+  const testFileBasename = loadTestFileBasename()
+  const inputs = [
+    'x.js (already exists)',
+    'dir/x.js',
+    'x.js',
+    'substrate/test/x.js (skipped: exists)',
+    '  x.js  ',
+  ]
+  for (const input of inputs) {
+    assert.equal(testFileBasename(input), 'x.js', `expected testFileBasename(${JSON.stringify(input)}) === 'x.js'`)
+  }
+})
