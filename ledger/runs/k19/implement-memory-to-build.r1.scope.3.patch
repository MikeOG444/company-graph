+// ---- BEGIN memory-patterns ----
+// Memory to Build (B1): selectPatterns and formatPatterns, pure script code (CLAUDE.md rule 3) that picks and
+// renders the patterns a memory-read agent (below) copied verbatim from a stored MemoryRoll. No `args`, `A`,
+// `log`, `agent` or any runtime binding is referenced anywhere in this block — callable standalone exactly like
+// graph-lint above (substrate/test/extract-fixloop.js idiom).
+
+// At most `max` patterns (default 5), every anti_pattern item before any other kind, and within each kind group
+// ordered by sample_size descending then id ascending. Malformed entries (missing id/claim, null, non-object) are
+// dropped; a non-array input yields []. The input array itself is never mutated — a fresh array is sorted.
+function selectPatterns(patterns, options = {}) {
+  const max = options.max ?? 5
+  const valid = (Array.isArray(patterns) ? patterns : []).filter(p =>
+    p && typeof p === 'object' && typeof p.id === 'string' && typeof p.claim === 'string')
+  const rank = (p) => (p.kind === 'anti_pattern' ? 0 : 1)
+  const sorted = [...valid].sort((a, b) =>
+    rank(a) - rank(b) ||
+    (Number(b.sample_size ?? 0) - Number(a.sample_size ?? 0)) ||
+    String(a.id).localeCompare(String(b.id)))
+  return sorted.slice(0, max)
+}
+
+// One line per selected pattern: '<id> (n=<sample_size>): <claim>'. [] renders as ''.
+function formatPatterns(selected) {
+  return (selected ?? []).map(p => `${p.id} (n=${p.sample_size}): ${p.claim}`).join('\n')
+}
+// ---- END memory-patterns ----
