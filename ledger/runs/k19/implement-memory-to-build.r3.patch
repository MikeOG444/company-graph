+// patterns/canaries verbatim from the stored roll. selectPatterns/formatPatterns (pure, above) turn that into
+// the text injected under a prior-observations heading in the Decomposer prompt only (never Spec Writer, Risk
+// Router, lenses or fixer). A missing, unreadable, empty or malformed roll leaves priorObservationsText === '',
+// which keeps the Decomposer prompt byte-identical to today's.
+let priorObservationsText = ''
+if (A.memory_ref && isSafeMemoryRef(A.memory_ref)) {
