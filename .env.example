# Copy to .env and fill in what you need:  cp .env.example .env
# Nothing loads .env on its own. Pass it explicitly (Node >= 20):
#   node --env-file=.env substrate/gates.js open ...
# `npm test` strips every NOTIFY_* var (substrate/test/no-live-notify.js), so tests never deliver for real.
# Everything is commented out on purpose: an unset NOTIFY_DRIVER means no delivery is ever attempted.

# --- Gate notifications (substrate/notify.js; see substrate/README.md) ---------------------------------------------
# Transport: github | webhook. Unset = no delivery.
# NOTIFY_DRIVER=github

# github driver: opens an issue labelled `gate` + `channel:phone|queue`. Use NOTIFY_GITHUB_TOKEN, never GITHUB_TOKEN.
# NOTIFY_GITHUB_TOKEN=
# NOTIFY_GITHUB_REPO=owner/repo
# NOTIFY_GITHUB_API=https://api.github.com

# webhook driver (UNVERIFIED FROM CI): POSTs a small JSON body here.
# NOTIFY_WEBHOOK_URL=

# Per-attempt delivery timeout in ms (default 5000).
# NOTIFY_TIMEOUT_MS=5000

# --- toy venture (toy/src) -------------------------------------------------------------------------------------------
# PORT=3000
# ADMIN_TOKEN=
